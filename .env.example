# --- Groq (replaces Gemini) ---
# Get this from console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# --- Telegram ---
# Get this from @BotFather. Current bot: samcotestbot
TELEGRAM_BOT_TOKEN=your_token_from_botfather

# --- Twilio WhatsApp (for later — leave blank until you switch back) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=

# --- Store ---
STORE_NAME=SAMCO Superstore
DEFAULT_CUSTOMER_EMAIL_DOMAIN=samcosuperstore.ng

# --- Database ---
DB_PATH=samco_agent.db

# --- Misc ---
MAX_TOOL_ROUNDS=6
MAX_HISTORY_MESSAGES=20
