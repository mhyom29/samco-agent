# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key_from_aistudio.google.com
GEMINI_MODEL=gemini-3.5-flash

# --- Telegram (this is what you're using for now) ---
# Get this from @BotFather on Telegram — see README.md
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Twilio WhatsApp (for later — leave blank until you switch back) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Paystack ---
# From your Paystack Dashboard: Settings > API Keys & Webhooks (use the TEST key while testing)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=

# --- Store ---
STORE_NAME=SAMCO Superstore
DEFAULT_CUSTOMER_EMAIL_DOMAIN=samcosuperstore.ng

# --- Database ---
DB_PATH=samco_agent.db

# --- Misc ---
MAX_TOOL_ROUNDS=6
